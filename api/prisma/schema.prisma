generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATRON
  LIBRARIAN
}

model User {
  id    String @id @default(cuid())
  email String @unique
  name  String
  role  Role   @default(PATRON)
}

model Genre {
  id    String @id @default(cuid())
  name  String @unique
  books Book[]
}

model Book {
  id      String @id @default(cuid())
  title   String
  author  String
  genreId String
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@index([genreId])
}
